{
    "name": "chrome-extension-automation",
    "version": "1.0.0",
    "type": "module",
    "dependencies": {
        "jest": "^29.7.0",
        "puppeteer": "^24.4.0"
    },
    "scripts": {
        "test": "jest ./tests/",
        "debug": "node --inspect-brk node_modules/jest/bin/jest.js",
        "build:prod": "npm run build",
        "lint": "eslint src",
        "lint:fix": "eslint src --fix",
        "test:i18n:unit": "node --test tests/i18n/*.test.mjs",
        "test:i18n:browser": "node tests/i18n/browser.mjs",
        "test:i18n": "npm run test:i18n:unit && npm run test:i18n:browser",
        "build": "node scripts/build.mjs",
        "build:chrome": "node scripts/build.mjs chrome",
        "build:firefox": "node scripts/build.mjs firefox"
    },
    "devDependencies": {
        "@eslint/js": "^9.23.0",
        "eslint": "^9.23.0",
        "globals": "^16.0.0"
    }
}
